# -----------------------------------------------------------------------------
# OpenHR Environment Configuration
# -----------------------------------------------------------------------------
# All variables have sensible local development defaults.
# In production, provide strong random secrets or use *_FILE variants.

# Application Environment
NODE_ENV=development
APP_PORT=3000
API_PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Database Configuration (PostgreSQL 17+)
# Migrations run as openhr_owner; application queries execute as openhr_app (NOBYPASSRLS)
DATABASE_URL=postgres://openhr_app:openhr_dev_password@localhost:5432/openhr
DATABASE_MIGRATION_URL=postgres://openhr_owner:openhr_dev_password@localhost:5432/openhr

# Authentication & Session Secrets (Better Auth)
BETTER_AUTH_SECRET=dev_auth_secret_must_be_changed_in_production_min_32_chars
BETTER_AUTH_URL=http://localhost:3001

# Envelope Encryption Key for sensitive fields (AES-256-GCM - exactly 32 bytes base64 encoded)
# Generate via: openssl rand -base64 32
ENVELOPE_MASTER_KEY=ZGV2X2VudmVsb3BlX21hc3Rlcl9rZXlfZm9yX2xvY2FsX2Rldg==
ENVELOPE_KEY_ID=v1

# Outbound Mail (SMTP / Mailpit in local dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OpenHR <noreply@openhr.local>

# Logging & Observability
LOG_LEVEL=info
