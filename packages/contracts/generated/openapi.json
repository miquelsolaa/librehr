              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              },
              "defaultLocale": {
                "type": "string"
              },
              "timezone": {
                "type": "string"
              }
            },
            "required": ["id", "name", "slug", "defaultLocale", "timezone"]
