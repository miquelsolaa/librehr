# Copy of infra/env/.env.example; keep the two files identical.
# -----------------------------------------------------------------------------
# LibreHR Environment Configuration
# -----------------------------------------------------------------------------
# Every value below is a PUBLIC, development-only default. In production the
# API and worker refuse to start with any of them (secrets must be unique and
# 32+ characters; DB URLs must not contain `dev_password`). Generate real values:
#   openssl rand -hex 32      # database role passwords (URL-safe)
#   openssl rand -base64 32   # all other secrets
# The API also accepts <NAME>_FILE (e.g. SESSION_SECRET_FILE) for the four
# application secrets, to use Docker secrets. See docs/guides/self-hosting.md.

# Application Environment
NODE_ENV=development
APP_PORT=3000
API_PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Database Configuration (PostgreSQL 16+)
# Requests run as librehr_app (NOBYPASSRLS, always bound by RLS); migrations and
# the worker run as librehr_owner. Production refuses a DATABASE_URL that
# connects as librehr_owner or the bootstrap superuser.
DATABASE_URL=postgres://librehr_app:librehr_dev_password@localhost:5432/librehr
DATABASE_MIGRATION_URL=postgres://librehr_owner:librehr_dev_password@localhost:5432/librehr

# Postgres container roles (production compose; dev compose sets its own).
# Applied by infra/postgres/init/00-roles.sh only when the data volume is first
# created. Use hex values: they are embedded in postgres:// URLs.
POSTGRES_PASSWORD=librehr_dev_password
LIBREHR_OWNER_PASSWORD=librehr_dev_password
LIBREHR_APP_PASSWORD=librehr_dev_password

# Authentication & Session Secrets
BETTER_AUTH_SECRET=dev_auth_secret_must_be_changed_in_production_min_32_chars
# Public origin of the API. Behind the bundled Caddy, the same value as APP_URL.
BETTER_AUTH_URL=http://localhost:3001
# Signs two-factor sign-in challenges. Same value on every API instance.
SESSION_SECRET=dev_session_secret_must_be_changed_in_production_32

# Envelope Encryption Key for sensitive fields (AES-256-GCM, 32 bytes base64).
# Back it up: losing it loses the encrypted data.
ENVELOPE_MASTER_KEY=ZGV2X2VudmVsb3BlX21hc3Rlcl9rZXlfZm9yX2xvY2FsX2Rldg==
ENVELOPE_KEY_ID=v1

# HMAC key of the time-record tamper-evidence chain (TIM-002); api AND worker.
# Keep it: changing it makes existing time records unverifiable.
TIME_CHAIN_KEY=dev_time_chain_key_must_be_changed_in_production_32

# Reverse proxy and public URLs (production compose)
# Host Caddy serves and requests a certificate for (the host of APP_URL).
DOMAIN=localhost
# Browser-facing API URL baked into the web image at build time. Leave empty to
# call the API on the web app's own origin (/v1/...), as the bundled Caddy does.
PUBLIC_API_URL=
# Reverse proxies in front of the API that append to X-Forwarded-For
# (1 behind the bundled Caddy). Never set it higher than the real hop count.
TRUST_PROXY=0

# Edge settings
# Extra allowed CORS origins, comma-separated (APP_URL is always allowed).
CORS_ORIGINS=
# AUTH-004 has no OIDC callback yet; keep SSO off.
SSO_ENABLED=false
# Development only: lets webhooks target http:// and private hosts.
# Never enabled in production.
WEBHOOKS_ALLOW_PRIVATE=false

# LibreHR Business licence key (LIC-002; docs/editions.md). Verified offline,
# never sent anywhere. Leave empty to run the Community edition.
LIBREHR_LICENSE_KEY=
# Development only: Ed25519 public key (PEM) to verify test licence keys
# instead of the embedded one. Refused in production.
LIBREHR_LICENSE_PUBLIC_KEY=

# Outbound Mail (SMTP / Mailpit in local dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LibreHR <noreply@librehr.local>

# Logging & Observability
LOG_LEVEL=info
